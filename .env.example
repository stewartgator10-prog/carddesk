# Copy to .env.local for `npm run dev`. In Netlify, set these under Site configuration > Environment variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Netlify Functions read SUPABASE_URL / SUPABASE_ANON_KEY and fall back to the VITE_ values above.
# Optional: comma-separated emails allowed to use the eBay functions (recommended).
ALLOWED_EMAILS=

# Existing eBay app keys (unchanged)
EBAY_APP_ID=
EBAY_CERT_ID=
